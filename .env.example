# Copy to .env (never commit .env). On Railway, set these as service Variables instead.
LITEROUTER_API_KEY=
MODEL_MAIN=mistral-large-2512:full-context
MODEL_CHEAP=qwen3.8-27b:free
LITEROUTER_BASE_URL=https://api.literouter.com/v1
PORT=8000
# Shared password locking the whole site (leave empty = open, local dev only).
ANEW_PASSWORD=
# Persistent data dir. Railway: mount a volume at /data and set ANEW_DATA_DIR=/data
# so chats (anew.db) and portraits survive restarts. Locally: leave empty.
ANEW_DATA_DIR=
